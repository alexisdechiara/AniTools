{
	"name": "ani-tools",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.5",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "bun run typecheck:app && bun run typecheck:server",
		"typecheck:app": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
		"typecheck:server": "vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
		"test": "bun run test:unit",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@directus/sdk": "^24.0.0",
		"@iconify-json/circle-flags": "^1.2.12",
		"@iconify-json/lucide": "^1.2.147",
		"@iconify-json/simple-icons": "^1.2.100",
		"@nuxt/image": "^2.2.0",
		"@nuxt/ui": "^4.12.0",
		"@nuxtjs/robots": "^6.2.4",
		"@nuxtjs/sitemap": "^8.6.2",
		"@pinia/nuxt": "^1.0.3",
		"@unovis/ts": "^1.7.1",
		"@unovis/vue": "^1.7.1",
		"@vueuse/nuxt": "^14.4.0",
		"grid-layout-plus": "^1.1.1",
		"nuxt": "^4.6.2",
		"nuxt-site-config": "^4.2.3",
		"pinia": "^4.1.0",
		"pinia-plugin-persistedstate": "^4.7.1",
		"reka-ui": "2.10.1",
		"vue-cal": "^5.0.1-rc.46",
		"vue-draggable-plus": "^0.6.1",
		"vue-timeline-chart": "^5.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.17.0",
		"@playwright/test": "^1.64.1",
		"@vitest/coverage-istanbul": "^4.1.12",
		"eslint": "^10.13.0",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.12",
		"vue-tsc": "^3.3.13"
	},
	"overrides": {
		"@vitest/mocker": "4.1.12",
		"@vue/server-renderer": "3.5.44",
		"brace-expansion": "5.0.12",
		"colord": "2.10.0",
		"esbuild": "0.28.1",
		"fast-uri": "3.1.9",
		"immutable": "5.1.9",
		"js-yaml": "4.3.2",
		"lodash": "4.18.1",
		"minimatch": "10.2.6",
		"nanoid": "3.3.18",
		"postcss-selector-parser": "7.1.7",
		"prosemirror-view": "1.42.6",
		"shell-quote": "1.12.0",
		"source-map-js": "1.2.2",
		"vitest": "4.1.12",
		"vue": "3.5.44"
	}
}

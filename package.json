{
	"name": "ani-tools",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.5",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "bun run typecheck:app && bun run typecheck:server",
		"typecheck:app": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
		"typecheck:server": "vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
		"test": "bun run test:unit",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@directus/sdk": "^24.0.0",
		"@iconify-json/circle-flags": "^1.2.10",
		"@iconify-json/lucide": "^1.2.120",
		"@iconify-json/simple-icons": "^1.2.92",
		"@nuxt/image": "^2.1.0",
		"@nuxt/ui": "^4.10.0",
		"@nuxtjs/robots": "^6.1.3",
		"@nuxtjs/sitemap": "^8.3.0",
		"@pinia/nuxt": "^1.0.1",
		"@unovis/ts": "^1.6.7",
		"@unovis/vue": "^1.6.7",
		"@vueuse/nuxt": "^14.4.0",
		"date-fns": "^4.4.0",
		"grid-layout-plus": "^1.1.1",
		"nuxt": "^4.5.1",
		"nuxt-site-config": "^4.1.2",
		"pinia": "^4.0.2",
		"pinia-plugin-persistedstate": "^4.7.1",
		"vue-cal": "^5.0.1-rc.46",
		"vue-draggable-plus": "^0.6.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.16.0",
		"@playwright/test": "^1.62.0",
		"@vitest/coverage-istanbul": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-plugin-tailwindcss": "^4.2.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.8"
	},
	"overrides": {
		"brace-expansion": "5.0.8",
		"esbuild": "0.28.1",
		"immutable": "5.1.9",
		"lodash": "4.18.1",
		"minimatch": "10.2.6"
	}
}

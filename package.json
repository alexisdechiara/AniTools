{
	"name": "ani-tools",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.5",
	"engines": {
		"node": ">=22.19.0",
		"bun": ">=1.3.5"
	},
	"scripts": {
		"audit:gate": "bun scripts/audit-gate.mjs",
		"check": "bun run lint && bun run typecheck && bun run test:unit && bun run build",
		"build": "nuxt build",
		"dev": "nuxt dev",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "bun run typecheck:app && bun run typecheck:server",
		"typecheck:app": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
		"typecheck:server": "vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
		"test": "bun run test:unit",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:nuxt": "vitest run --project nuxt",
		"test:e2e": "playwright test",
		"test:e2e:build": "bun run build && PLAYWRIGHT_TARGET=build playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@directus/sdk": "^27.1.0",
		"@iconify-json/circle-flags": "^1.2.14",
		"@iconify-json/lucide": "^1.2.153",
		"@iconify-json/simple-icons": "^1.2.102",
		"@nuxt/image": "^2.2.1",
		"@nuxt/ui": "^4.12.0",
		"@nuxtjs/robots": "^7.0.2",
		"@nuxtjs/sitemap": "^9.1.0",
		"@pinia/nuxt": "^1.0.3",
		"@unovis/ts": "^1.8.0",
		"@unovis/vue": "^1.8.0",
		"@vueuse/nuxt": "^15.0.0",
		"grid-layout-plus": "^1.1.1",
		"nuxt": "^4.6.4",
		"nuxt-site-config": "^5.0.3",
		"pinia": "^4.1.0",
		"pinia-plugin-persistedstate": "^4.7.1",
		"reka-ui": "^2.11.0",
		"vue-cal": "5.0.1-rc.46",
		"vue-draggable-plus": "^0.6.1",
		"vue-timeline-chart": "^5.3.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.17.0",
		"@nuxt/test-utils": "^4.4.0",
		"@playwright/test": "^1.65.0",
		"@vitest/coverage-istanbul": "^5.1.0",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^10.14.0",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"happy-dom": "^21.0.4",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0",
		"vue-tsc": "^3.3.14"
	},
	"overrides": {
		"node-forge": "1.4.1",
		"vite": "8.3.4"
	}
}

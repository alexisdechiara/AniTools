# SEO / Canonical base URL and trusted origin for unsafe auth requests.
# Required in production, for example: https://anitools.example.com
NUXT_SITE_URL=

# production | preview | development
NUXT_SITE_ENV=production

# APIs
NUXT_PUBLIC_DIRECTUS_URL=

# AniList OAuth (server-only)
# Create the application at https://anilist.co/settings/developer.
NUXT_ANILIST_CLIENT_ID=
NUXT_ANILIST_CLIENT_SECRET=
NUXT_ANILIST_REDIRECT_URI=http://localhost:3000/auth/anilist/callback

# At least 32 random characters. Example: openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# Optional key rotation. During a rotation, set this to the former
# NUXT_SESSION_PASSWORD, deploy the new current password, then remove this value
# after the longest existing session lifetime (currently one year).
NUXT_SESSION_PREVIOUS_PASSWORD=

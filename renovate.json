{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group Nuxt ecosystem updates",
      "matchPackageNames": [
        "nuxt",
        "@nuxt/**",
        "@nuxtjs/**",
        "nuxt-*"
      ],
      "groupName": "Nuxt ecosystem"
    },
    {
      "description": "Group non-major developer tooling updates",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "developer tooling"
    },
    {
      "description": "Pin GitHub Actions to immutable digests",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  }
}
